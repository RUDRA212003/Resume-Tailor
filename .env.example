# ResumeCraft – Environment Configuration
# Copy this file to .env.local for local development

# ==============================================================================
# Database: MongoDB Configuration
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/resumecraft?retryWrites=true&w=majority

# ==============================================================================
# Google Gemini AI Provider (Server-Side Only - Never exposed to client)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ==============================================================================
# Auth0 Authentication Credentials
# ==============================================================================
APP_BASE_URL=http://localhost:3000
AUTH0_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your_tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_SECRET=your_auth0_session_secret_min_32_characters
