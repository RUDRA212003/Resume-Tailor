# ResumeCraft – Environment Configuration
# Copy this file to .env.local for local development

# ==============================================================================
# Database: MongoDB Configuration
# ==============================================================================
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/resumecraft?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# ==============================================================================
# Google Gemini AI Provider (Server-Side Only - Never exposed to client)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ==============================================================================
# Supabase Configuration (Optional for cloud database & Auth)
# When omitted, ResumeCraft seamlessly runs in resilient local repository mode
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
